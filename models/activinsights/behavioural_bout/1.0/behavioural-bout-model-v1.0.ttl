@prefix : <https://w3id.org/coel/models/activinsights/behavioural_bout/1.0#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/coel/models/activinsights/behavioural_bout/1.0> rdf:type owl:Ontology .
<https://w3id.org/coel/models/activinsights/behavioural_bout/1.0> rdfs:label "Behavioural Bout Model v1.0" .

# Annotation property to flag direct model outputs
:isDirectOutputLabel a owl:AnnotationProperty .

:BehaviouralBout a owl:Class ;
    rdfs:label "BehaviouralBout" ;
    rdfs:comment "Root of the classification tree used in ActivInsights 24hr behavioural bout analysis." ;
    :isDirectOutputLabel "false"^^xsd:boolean .

:NonWear a owl:Class ;
    rdfs:label "NonWear" ;
    rdfs:comment "Measurement device not worn." ;
    :isDirectOutputLabel "true"^^xsd:boolean ;
    rdfs:subClassOf :BehaviouralBout .

:Sedentary a owl:Class ;
    rdfs:label "Sedentary" ;
    rdfs:comment "Sitting or reclining posture (and MET below 1.5)." ;
    :isDirectOutputLabel "true"^^xsd:boolean ;
    rdfs:subClassOf :BehaviouralBout .

:Active a owl:Class ;
    rdfs:label "Active" ;
    rdfs:comment "Active physical behaviour (light, moderate and vigorous MET)." ;
    :isDirectOutputLabel "true"^^xsd:boolean ;
    rdfs:subClassOf :BehaviouralBout .

:Ambulatory a owl:Class ;
    rdfs:label "Ambulatory" ;
    rdfs:comment "Ambulatory physical behaviour." ;
    :isDirectOutputLabel "false"^^xsd:boolean ;
    rdfs:subClassOf :Active .

:SlowWalk a owl:Class ;
    rdfs:label "SlowWalk" ;
    rdfs:comment "Walking slower than median cadence (nominally 70 steps per minute)." ;
    :isDirectOutputLabel "true"^^xsd:boolean ;
    rdfs:subClassOf :Ambulatory .

:FastWalk a owl:Class ;
    rdfs:label "FastWalk" ;
    rdfs:comment "Walking faster than median cadence (nominally 70 steps per minute)." ;
    :isDirectOutputLabel "true"^^xsd:boolean ;
    rdfs:subClassOf :Ambulatory .

:Run a owl:Class ;
    rdfs:label "Run" ;
    rdfs:comment "Running." ;
    :isDirectOutputLabel "true"^^xsd:boolean ;
    rdfs:subClassOf :Ambulatory .

:Sleep a owl:Class ;
    rdfs:label "Sleep" ;
    rdfs:comment "Sleep." ;
    :isDirectOutputLabel "true"^^xsd:boolean ;
    rdfs:subClassOf :Sedentary .

