{
  "@context": {
    "prov": "http://www.w3.org/ns/prov#",
    "dcterms": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "Header": {
      "@context": {
        "AtomID": "dcterms:identifier",
        "AtomIRI": { "@id": "dcterms:conformsTo", "@type": "@id" }
      }
    },

    "When": {
      "@context": {
        "TimeUTC": { "@id": "dcterms:temporal", "@type": "xsd:integer" },
        "Duration": { "@id": "dcterms:extent", "@type": "xsd:integer" },
        "UTCOffset": { "@id": "dcterms:spatial", "@type": "xsd:integer" }
      }
    },

    "What": {
      "@context": {
        "LabelIRI": { "@id": "dcterms:subject", "@type": "@id", "@container": "@set" }
      }
    },

    "Who": {
      "@context": {
        "ParticipantID": "dcterms:references",
        "EnvironmentID": "dcterms:references"
      }
    },

    "How": {
      "@id": "prov:wasGeneratedBy",
      "@type": "prov:Activity",
      "@context": {
        "EvidenceType": { "@id": "dcterms:type", "@type": "xsd:integer" },
        "EvidenceSystem": "dcterms:description",
        "ClassificationModelIRI": { "@id": "prov:used", "@type": "@id", "@container": "@set" },
        "AssessmentTimeISO": { "@id": "prov:endedAtTime", "@type": "xsd:dateTime" },
        "EvidenceID": "dcterms:identifier"
      }
    }
  }
}